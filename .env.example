# Database - PostgreSQL connection string
# Local: postgresql://user:password@localhost:5432/askbeautox
# Or use a hosted service like Supabase, Railway, or Neon
DATABASE_URL="postgresql://user:password@localhost:5432/askbeautox"

# NextAuth.js Configuration
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl"
NEXTAUTH_URL="http://localhost:3000"

# Stripe Configuration
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
# Create a product at https://dashboard.stripe.com/products and copy the price ID
STRIPE_PRICE_ID="price_your_price_id"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"

# Anthropic Claude API
# Get your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-your_anthropic_api_key"

# Etsy Open API v3 (create app at https://www.etsy.com/developers/register)
# Keystring = client ID, Shared secret = client secret (server-side only)
ETSY_API_KEYSTRING="your_etsy_keystring"
ETSY_API_SHARED_SECRET="your_etsy_shared_secret"
# Must be https:// and match Your Apps — Etsy rejects http://localhost for OAuth authorize
ETSY_OAUTH_REDIRECT_URI="https://nopriorauthorization.com/api/etsy/callback"
# Shop identifier from Etsy (Shop Manager / developer tools — not the shared secret)
# Used after OAuth so API calls target your shop; format may be numeric or string per Etsy
# ETSY_SHOP_ID="your_shop_id"
# Optional: scopes your app requests (see https://developers.etsy.com/)
# ETSY_OAUTH_SCOPES="shops_r listings_r"

# Canva Connect API
# Create an integration at https://www.canva.com/developers/integrations
CANVA_CLIENT_ID="your_canva_client_id"
CANVA_CLIENT_SECRET="your_canva_client_secret"
# Must exactly match one Authorized redirect in Canva developer settings
CANVA_OAUTH_REDIRECT_URI="http://127.0.0.1:3000/api/canva/callback"
# Scopes: enable the same ones in the Canva portal, then reconnect OAuth.
# P0: profile:read design:meta:read (list designs)
# P1: add design:content:read (export designs to PNG/PDF)
# P2: add design:content:write (create buyer copies)
# CANVA_OAUTH_SCOPES="profile:read design:meta:read design:content:read"
# Optional: JSON from GET /api/canva/list-designs for npm run store:fill / store:build (default imports/canva-list-designs.json)
# CANVA_LIST_DESIGNS_JSON="/absolute/path/list-designs.json"
# Optional dev only: after OAuth, server logs CANVA_ACCESS_TOKEN — paste here so /api/canva/list-designs works without browser cookie (not used in production)
# CANVA_ACCESS_TOKEN=""

# Buyer delivery links for Canva products
# Used to sign secure fulfillment links. If omitted, NEXTAUTH_SECRET is used.
# DELIVERY_TOKEN_SECRET="generate-a-long-random-secret"
# Optional admin key for POST /api/delivery/issue and POST /api/admin/sync-delivery-manifests (curl/CI)
# DELIVERY_ADMIN_KEY="another-long-random-secret"
#
# postbuild runs scripts/sync-manifests-to-db.mjs when DATABASE_URL is set (Vercel production),
# so manifests in imports/npa-manifests-and-spec/ are written to Analytics automatically.

# Square Payments (production credentials from developer.squareup.com)
# Application ID from Credentials page
SQUARE_APPLICATION_ID="sq0idp-your_application_id"
# Production Access Token — click copy on Credentials page
SQUARE_ACCESS_TOKEN="your_production_access_token"
# Location ID — Square Dashboard > Account & Settings > Locations
SQUARE_LOCATION_ID="your_location_id"
# Webhook signature key — created when you add a webhook subscription
SQUARE_WEBHOOK_SIGNATURE_KEY="your_webhook_signature_key"
# "production" or "sandbox"
SQUARE_ENVIRONMENT="production"

# Supabase (Storage + service role — used for vault uploads and Facebook image pipeline)
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# Public bucket for NPA Facebook image posts (create in Dashboard → Storage → New bucket → Public)
SUPABASE_SOCIAL_BUCKET="social-posts"

# Facebook Page posting from NPA admin — targets Hello Gorgeous Page (not a separate NPA Page)
# Prefer OAuth: Admin → Social → Connect Facebook (stores Page token in DB). FB_PAGE_ACCESS_TOKEN is optional fallback.
# Meta: App → Facebook Login → Settings → Valid OAuth Redirect URIs must match FB_REDIRECT_URI exactly (scheme, host, path, port).
# Production example: https://nopriorauthorization.com/api/auth/facebook/callback
# Local example (match your dev port): http://localhost:3000/api/auth/facebook/callback
FB_PAGE_ID=""
FB_PAGE_ACCESS_TOKEN=""
FB_APP_ID=""
FB_APP_SECRET=""
FB_REDIRECT_URI=""
# Vercel sends Authorization: Bearer CRON_SECRET when invoking cron jobs
CRON_SECRET=""

# Product automation pipeline (CLI — see docs/TICKET-PIPELINE-IMPLEMENTATION-NEXT.md)
# PRODUCT_OUTPUT_DIR="./output"
# Optional: paste token for Canva REST calls from Node scripts (OAuth cookies are browser-only)
# CANVA_ACCESS_TOKEN=
