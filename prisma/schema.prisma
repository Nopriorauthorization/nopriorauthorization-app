generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                             String               @id @default(cuid())
  email                          String               @unique
  passwordHash                   String
  name                           String?
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt
  accountDeletionRequestedAt     DateTime?
  allowProviderToProviderSharing Boolean              @default(false)
  consentToShareClinicalSummary  Boolean              @default(false)
  copyToEHRFormat                String?              @default("plain_text")
  dataExportRequestedAt          DateTime?
  defaultClinicalSummaryView     String?              @default("provider")
  emailNotificationsEnabled      Boolean              @default(true)
  includeProviderNotesInShares   Boolean              @default(false)
  lastAccessAt                   DateTime?
  role                           UserRole             @default(PATIENT)
  isDisabled                     Boolean              @default(false)
  subscriptionTier               SubscriptionTier     @default(FREE)
  
  // NPA Health ID - Immutable patient identifier (Phase 1)
  // Format: npa_xxxxxxxx_xxxx_xxxx_xxxx (96 bits entropy)
  npaId                          String?              @unique
  npaIdAlias                     String?              // Human-readable display alias
  npaStatus                      NpaStatus            @default(ACTIVE)
  
  appointments                   Appointment[]
  blueprint                      Blueprint?
  chatSessions                   ChatSession[]
  consentChangeLogs              ConsentChangeLog[]
  dataRequests                   DataRequest[]
  passwordResetTokens            PasswordResetToken[]
  subscription                   Subscription?
  disableEvents                  UserDisableEvent[]
  memory                         UserMemory?
  Vault                          Vault?
  identityAuditLogs              IdentityAuditLog[]
  npaVaultDocuments              NpaVaultDocument[]
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  stripeCustomerId String    @unique
  stripeSubId      String?   @unique
  status           String    @default("inactive")
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Analytics {
  id        String   @id @default(cuid())
  event     String
  metadata  Json?
  userId    String?
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
}

model UserMemory {
  id                     String   @id @default(cuid())
  userId                 String?  @unique
  anonId                 String?  @unique
  goals                  Json?
  preferences            Json?
  topicsDiscussed        Json?
  disclaimerAcknowledged Boolean  @default(false)
  optOut                 Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  vaultName              String?
  onboardingCompleted    Boolean  @default(false)
  user                   User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([anonId])
}

model Blueprint {
  id                String   @id @default(cuid())
  userId            String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  identityContext   Json?
  healthFoundations Json?
  treatments        Json?
  timeline          Json?
  documents         Json?
  providers         Json?
  preparation       Json?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Document {
  id                     String              @id @default(cuid())
  userId                 String?
  anonId                 String?
  title                  String
  category               DocumentCategory    @default(OTHER)
  docDate                DateTime?
  storagePath            String
  mimeType               String
  sizeBytes              Int
  includeInPacketDefault Boolean             @default(false)
  createdAt              DateTime            @default(now())
  deletedAt              DateTime?
  decode                 DocumentDecode?     @relation("DocumentDecode")
  shareLinks             DocumentShareLink[]

  @@index([userId])
  @@index([anonId])
}

model DocumentDecode {
  id         String   @id @default(cuid())
  documentId String   @unique
  summary    String
  keyTerms   Json
  questions  Json
  nextSteps  Json
  safetyNote String?
  createdAt  DateTime @default(now())
  Document   Document @relation("DocumentDecode", fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentShareLink {
  id         String                    @id @default(cuid())
  documentId String
  token      String                    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime                  @default(now())
  revokedBy  String?
  document   Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  accesses   DocumentShareLinkAccess[]

  @@index([documentId])
}

model DocumentShareLinkAccess {
  id          String            @id @default(cuid())
  shareLinkId String
  accessedAt  DateTime          @default(now())
  ipAddress   String?
  userAgent   String?
  shareLink   DocumentShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
}

model ProviderPacket {
  id         String                 @id @default(cuid())
  userId     String?
  anonId     String?
  template   ProviderPacketTemplate @default(PRIMARY)
  payload    Json
  createdAt  DateTime               @default(now())
  shareLinks ProviderPacketLink[]

  @@index([userId])
  @@index([anonId])
}

model ProviderPacketLink {
  id        String                    @id @default(cuid())
  token     String                    @unique
  packetId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime                  @default(now())
  accesses  ProviderPacketAccessLog[]
  packet    ProviderPacket            @relation(fields: [packetId], references: [id], onDelete: Cascade)

  @@index([packetId])
}

model ProviderPacketAccessLog {
  id                   String             @id @default(cuid())
  providerPacketLinkId String
  accessedAt           DateTime           @default(now())
  ipAddress            String?
  userAgent            String?
  link                 ProviderPacketLink @relation(fields: [providerPacketLinkId], references: [id], onDelete: Cascade)
}

model AccessLog {
  id            String   @id @default(cuid())
  actorId       String?
  subjectUserId String?
  action        String
  resourceType  String
  resourceId    String
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

model UserDisableEvent {
  id         String    @id @default(cuid())
  userId     String
  disabledAt DateTime  @default(now())
  disabledBy String
  reason     String?
  resolvedAt DateTime?
  resolvedBy String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([disabledAt])
  @@index([resolvedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model ConsentChangeLog {
  id          String   @id @default(cuid())
  userId      String
  consentType String
  oldValue    Boolean
  newValue    Boolean
  changedBy   String?
  changedAt   DateTime @default(now())
  source      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, changedAt])
  @@index([consentType])
  @@index([changedAt])
}

model DataRequest {
  id                 String    @id @default(cuid())
  userId             String
  requestType        String
  status             String    @default("pending")
  requestedAt        DateTime  @default(now())
  fulfilledAt        DateTime?
  fulfilledBy        String?
  cancelledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?
  notes              String?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([requestType])
  @@index([requestedAt])
}

model Appointment {
  id                String   @id @default(cuid())
  userId            String?
  anonId            String?
  providerName      String
  providerSpecialty String?
  appointmentDate   DateTime
  appointmentType   String
  status            String   @default("scheduled")
  location          String?
  notes             String?
  reminderSent      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([anonId])
  @@index([appointmentDate])
  @@index([status])
}

model Provider {
  id        String           @id @default(cuid())
  userId    String?
  anonId    String?
  name      String
  specialty String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  tags      String[]         @default([])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  ratings   ProviderRating[]

  @@index([userId])
  @@index([anonId])
}

model ProviderRating {
  id             String   @id @default(cuid())
  userId         String?
  anonId         String?
  providerId     String
  providerName   String
  specialty      String?
  rating         Int
  tags           String[] @default([])
  notes          String?
  wouldRecommend Boolean  @default(true)
  lastVisit      DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  provider       Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([anonId])
  @@index([providerId])
}

model PhotoComparison {
  id          String   @id @default(cuid())
  userId      String?
  anonId      String?
  beforePhoto String
  afterPhoto  String
  title       String?
  notes       String?
  daysBetween Int?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([anonId])
  @@index([category])
}

model VoiceMemo {
  id         String   @id @default(cuid())
  userId     String?
  anonId     String?
  audioUrl   String
  transcript String?
  title      String?
  duration   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([anonId])
  @@index([createdAt])
}

model RedFlag {
  id          String   @id @default(cuid())
  userId      String?
  anonId      String?
  type        String
  severity    String
  title       String
  description String
  medications String[] @default([])
  dismissed   Boolean  @default(false)
  detectedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([anonId])
  @@index([dismissed])
  @@index([severity])
}

model TrustedCircleMember {
  id           String    @id @default(cuid())
  userId       String
  name         String
  email        String
  relationship String?
  permissions  String[]  @default([])
  status       String    @default("pending")
  invitedAt    DateTime  @default(now())
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([email])
  @@index([status])
}

model TrustedCircleInvite {
  id           String    @id @default(cuid())
  userId       String
  inviteeName  String
  inviteeEmail String
  relationship String?
  permissions  String[]  @default([])
  token        String    @unique @default(cuid())
  status       String    @default("pending")
  expiresAt    DateTime?
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([token])
  @@index([status])
  @@index([inviteeEmail])
}

model BlueprintInsight {
  id        String          @id
  vaultId   String
  source    InsightSource
  priority  InsightPriority
  message   String
  createdAt DateTime        @default(now())
  updatedAt DateTime
  Vault     Vault           @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@index([priority])
  @@index([source])
  @@index([vaultId])
}

model FamilyMember {
  id            String   @id
  vaultId       String
  relationship  String
  conditionTags String[] @default([])
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  Vault         Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@index([relationship])
  @@index([vaultId])
}

model FeatureFlag {
  id                String              @id
  key               String              @unique
  name              String
  description       String?
  type              FeatureFlagType     @default(EMERGENCY_TOGGLE)
  enabled           Boolean             @default(true)
  defaultValue      Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  FeatureFlagChange FeatureFlagChange[]

  @@index([enabled])
  @@index([key])
  @@index([type])
}

model FeatureFlagChange {
  id          String      @id
  flagId      String
  changedBy   String
  oldValue    Boolean
  newValue    Boolean
  reason      String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())
  FeatureFlag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([changedBy])
  @@index([createdAt])
  @@index([flagId])
}

model LabResult {
  id            String    @id
  vaultItemId   String
  testName      String
  flags         String[]  @default([])
  parsedSummary String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  VaultItem     VaultItem @relation(fields: [vaultItemId], references: [id], onDelete: Cascade)

  @@index([vaultItemId])
}

model MascotScript {
  id                 String               @id
  mascotId           String
  version            String
  status             MascotScriptStatus   @default(DRAFT)
  title              String
  description        String?
  scriptContent      Json
  audioEnabled       Boolean              @default(true)
  autoplayEnabled    Boolean              @default(false)
  createdBy          String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  MascotScriptChange MascotScriptChange[]

  @@unique([mascotId, version])
  @@index([mascotId])
  @@index([status])
  @@index([version])
}

model MascotScriptChange {
  id           String       @id
  scriptId     String
  changedBy    String
  changeType   String
  oldValue     Json?
  newValue     Json?
  reason       String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime     @default(now())
  MascotScript MascotScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@index([changedBy])
  @@index([createdAt])
  @@index([scriptId])
}

model SystemHealthCheck {
  id        String   @id
  service   String
  status    String
  message   String?
  latency   Int?
  checkedAt DateTime @default(now())

  @@index([checkedAt])
  @@index([service])
  @@index([status])
}

model Vault {
  id               String             @id
  userId           String             @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  BlueprintInsight BlueprintInsight[]
  FamilyMember     FamilyMember[]
  User             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  VaultItem        VaultItem[]

  @@index([userId])
}

model VaultItem {
  id        String        @id
  vaultId   String
  type      VaultItemType
  title     String
  metadata  Json
  createdAt DateTime      @default(now())
  updatedAt DateTime
  LabResult LabResult[]
  Vault     Vault         @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([vaultId])
}

enum UserRole {
  PATIENT
  PROVIDER
  ADMIN
}

enum DocumentCategory {
  LAB
  IMAGING
  VISIT_NOTE
  DISCHARGE
  OTHER
}

enum ProviderPacketTemplate {
  PRIMARY
  SPECIALIST
  URGENT
}

enum FeatureFlagType {
  EMERGENCY_TOGGLE
  SYSTEM_CONTROL
  MASCOT_CONTROL
}

enum InsightPriority {
  HIGH
  MEDIUM
  LOW
}

enum InsightSource {
  LAB
  FAMILY
  TOOL
  DOCUMENT
}

enum MascotScriptStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SubscriptionTier {
  FREE
  CORE
  PREMIUM
}

enum VaultItemType {
  DOCUMENT
  LAB
  NOTE
  TOOL_OUTPUT
}

// ============================================
// NPA PHASE 1: IDENTITY FOUNDATION
// ============================================

enum NpaStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum IdentityAuditAction {
  ACCOUNT_CREATED
  NPA_ID_GENERATED
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PROFILE_UPDATED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  ACCOUNT_DELETED
}

model IdentityAuditLog {
  id        String              @id @default(cuid())
  userId    String?
  npaId     String?
  action    IdentityAuditAction
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime            @default(now())
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([npaId])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// NPA PHASE 2: PATIENT-OWNED VAULT STORAGE
// ============================================

enum NpaDocumentSource {
  EPIC_MYCHART
  CERNER
  ATHENA
  ALLSCRIPTS
  MEDITECH
  NEXTGEN
  ECW
  PATIENT_UPLOAD
  PROVIDER_UPLOAD
  INSURANCE
  LAB_DIRECT
  IMAGING_CENTER
  PHARMACY
  OTHER
}

enum NpaDocumentCategory {
  LAB_RESULT
  IMAGING_REPORT
  IMAGING_SCAN
  VISIT_SUMMARY
  DISCHARGE_SUMMARY
  MEDICATION_LIST
  ALLERGY_LIST
  IMMUNIZATION_RECORD
  PROCEDURE_NOTE
  OPERATIVE_REPORT
  PATHOLOGY_REPORT
  REFERRAL
  INSURANCE_CARD
  INSURANCE_EOB
  CCDA_CCD
  CARE_PLAN
  CONSENT_FORM
  ADVANCE_DIRECTIVE
  OTHER
}

model NpaVaultDocument {
  id               String              @id @default(cuid())
  npaId            String
  userId           String?
  title            String
  category         NpaDocumentCategory @default(OTHER)
  source           NpaDocumentSource   @default(PATIENT_UPLOAD)
  sourceSystem     String?
  dateOfCare       DateTime?
  dateReceived     DateTime?
  uploadedAt       DateTime            @default(now())
  storagePath      String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  extractedText    String?
  isDeleted        Boolean             @default(false)
  deletedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  auditLogs        NpaVaultAuditLog[]
  shareLinks       NpaVaultShareLink[]

  @@index([npaId])
  @@index([userId])
  @@index([category])
  @@index([source])
  @@index([dateOfCare])
  @@index([uploadedAt])
  @@index([isDeleted])
}

enum NpaVaultAction {
  UPLOADED
  VIEWED
  DOWNLOADED
  METADATA_UPDATED
  DELETED
  RESTORED
  SHARED
  SHARE_REVOKED
}

model NpaVaultAuditLog {
  id         String           @id @default(cuid())
  documentId String
  npaId      String
  action     NpaVaultAction
  actorId    String?
  actorNpaId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime         @default(now())
  document   NpaVaultDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([npaId])
  @@index([action])
  @@index([createdAt])
}

model NpaVaultShareLink {
  id          String                    @id @default(cuid())
  documentId  String
  npaId       String
  token       String                    @unique
  canDownload Boolean                   @default(false)
  canUpload   Boolean                   @default(false)
  expiresAt   DateTime
  isRevoked   Boolean                   @default(false)
  revokedAt   DateTime?
  revokedBy   String?
  createdAt   DateTime                  @default(now())
  document    NpaVaultDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  accesses    NpaVaultShareLinkAccess[]

  @@index([documentId])
  @@index([npaId])
  @@index([token])
  @@index([expiresAt])
}

model NpaVaultShareLinkAccess {
  id          String            @id @default(cuid())
  shareLinkId String
  accessedAt  DateTime          @default(now())
  ipAddress   String?
  userAgent   String?
  shareLink   NpaVaultShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@index([shareLinkId])
  @@index([accessedAt])
}
