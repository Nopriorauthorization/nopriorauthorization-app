generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  PROVIDER
  ADMIN
}

enum SubscriptionTier {
  FREE
  CORE
  PREMIUM
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         UserRole  @default(PATIENT)
  subscriptionTier SubscriptionTier @default(FREE)
  isDisabled   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastAccessAt DateTime?

  // NPA Health ID - Immutable patient identifier (Phase 1)
  npaId        String?   @unique
  npaIdAlias   String?
  npaStatus    NpaStatus @default(ACTIVE)

  // Privacy & Consent
  consentToShareClinicalSummary  Boolean @default(false)
  allowProviderToProviderSharing Boolean @default(false)
  emailNotificationsEnabled      Boolean @default(true)

  // Provider-only settings
  defaultClinicalSummaryView   String? @default("provider")
  includeProviderNotesInShares Boolean @default(false)
  copyToEHRFormat              String? @default("plain_text")

  // Data controls
  dataExportRequestedAt      DateTime?
  accountDeletionRequestedAt DateTime?

  chatSessions        ChatSession[]
  subscription        Subscription?
  memory              UserMemory?
  blueprint           Blueprint?
  vault               Vault?
  security            UserSecurity?
  disableEvents       UserDisableEvent[]
  passwordResetTokens PasswordResetToken[]
  consentChangeLogs   ConsentChangeLog[]
  dataRequests        DataRequest[]
  appointments        Appointment[]
  identityAuditLogs   IdentityAuditLog[]
  npaVaultDocuments   NpaVaultDocument[]
  shareSessions       NpaShareSession[]    // Phase 4: Sharing
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  stripeCustomerId String    @unique
  stripeSubId      String?   @unique
  status           String    @default("inactive")
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Analytics {
  id        String   @id @default(cuid())
  event     String
  metadata  Json?
  userId    String?
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
}

model UserMemory {
  id                     String   @id @default(cuid())
  userId                 String?  @unique
  anonId                 String?  @unique
  goals                  Json?
  preferences            Json?
  topicsDiscussed        Json?
  vaultName              String? // Personalized name for Sacred Vault
  disclaimerAcknowledged Boolean  @default(false)
  onboardingCompleted    Boolean  @default(false) // Tracks if user completed Phase 4B onboarding
  optOut                 Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([anonId])
}

model Blueprint {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Blueprint Sections
  identityContext      Json? // Personal identity, values, context
  healthFoundations    Json? // Core health conditions, diagnoses
  treatments           Json? // Current and past treatments, medications
  timeline             Json? // Health journey timeline, milestones
  documents            Json? // Key documents, media references
  providers            Json? // Care team, providers, relationships
  preparation          Json? // Advocacy prep, questions, goals

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum DocumentCategory {
  LAB
  IMAGING
  VISIT_NOTE
  DISCHARGE
  OTHER
}

model Document {
  id                     String           @id @default(cuid())
  userId                 String?
  anonId                 String?
  title                  String
  category               DocumentCategory @default(OTHER)
  docDate                DateTime?
  storagePath            String
  mimeType               String
  sizeBytes              Int
  includeInPacketDefault Boolean          @default(false)
  createdAt              DateTime         @default(now())
  deletedAt              DateTime?

  shareLinks DocumentShareLink[]
  decode     DocumentDecode?    @relation("DocumentDecode")

  @@index([userId])
  @@index([anonId])
}

model DocumentDecode {
  id         String   @id @default(cuid())
  documentId String   @unique
  summary    String   @db.Text
  keyTerms   Json // Array of {term, definition, category}
  questions  Json // Array of strings
  nextSteps  Json // Array of strings
  safetyNote String?  @db.Text
  createdAt  DateTime @default(now())

  Document Document @relation("DocumentDecode", fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentShareLink {
  id         String    @id @default(cuid())
  documentId String
  token      String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  revokedBy  String?
  createdAt  DateTime  @default(now())

  document Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  accesses DocumentShareLinkAccess[]

  @@index([documentId])
}

model DocumentShareLinkAccess {
  id          String   @id @default(cuid())
  shareLinkId String
  accessedAt  DateTime @default(now())
  ipAddress   String?
  userAgent   String?

  shareLink DocumentShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
}

enum ProviderPacketTemplate {
  PRIMARY
  SPECIALIST
  URGENT
}

model ProviderPacket {
  id        String                 @id @default(cuid())
  userId    String?
  anonId    String?
  template  ProviderPacketTemplate @default(PRIMARY)
  payload   Json
  createdAt DateTime               @default(now())

  shareLinks ProviderPacketLink[]

  @@index([userId])
  @@index([anonId])
}

model ProviderPacketLink {
  id        String    @id @default(cuid())
  token     String    @unique
  packetId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  packet   ProviderPacket            @relation(fields: [packetId], references: [id], onDelete: Cascade)
  accesses ProviderPacketAccessLog[]

  @@index([packetId])
}

model ProviderPacketAccessLog {
  id                   String   @id @default(cuid())
  providerPacketLinkId String
  accessedAt           DateTime @default(now())
  ipAddress            String?
  userAgent            String?

  link ProviderPacketLink @relation(fields: [providerPacketLinkId], references: [id], onDelete: Cascade)
}

model AccessLog {
  id            String   @id @default(cuid())
  actorId       String? // who performed the action
  subjectUserId String? // whose PHI was accessed
  action        String // VIEW, EXPORT, SHARE, REVOKE
  resourceType  String // CLINICAL_SUMMARY, DOCUMENT, PROVIDER_PACKET
  resourceId    String
  ipAddress     String?
  userAgent     String?
  metadata      Json? // additional context
  createdAt     DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// User Disable Events - Preserves history across multiple disable/enable cycles
model UserDisableEvent {
  id         String    @id @default(cuid())
  userId     String
  disabledAt DateTime  @default(now())
  disabledBy String // Admin user ID who performed the disable
  reason     String? // Optional free text reason
  resolvedAt DateTime? // When account was re-enabled (null = still disabled)
  resolvedBy String? // Admin user ID who re-enabled

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([disabledAt])
  @@index([resolvedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model ConsentChangeLog {
  id          String   @id @default(cuid())
  userId      String
  consentType String // "clinicalSummary", "providerSharing", "emailNotifications"
  oldValue    Boolean
  newValue    Boolean
  changedBy   String? // User ID who made the change (null = user themselves)
  changedAt   DateTime @default(now())
  source      String // "user_settings", "admin_portal", "onboarding"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, changedAt])
  @@index([consentType])
  @@index([changedAt])
}

model DataRequest {
  id                 String    @id @default(cuid())
  userId             String
  requestType        String // "export", "deletion"
  status             String    @default("pending") // "pending", "in_progress", "completed", "cancelled"
  requestedAt        DateTime  @default(now())
  fulfilledAt        DateTime?
  fulfilledBy        String? // Admin user ID who fulfilled the request
  cancelledAt        DateTime?
  cancelledBy        String? // Admin user ID who cancelled the request
  cancellationReason String?
  notes              String? // Admin notes about the request

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([requestType])
  @@index([requestedAt])
}

model Appointment {
  id                String   @id @default(cuid())
  userId            String?
  anonId            String?
  providerName      String
  providerSpecialty String?
  appointmentDate   DateTime
  appointmentType   String // "checkup", "follow-up", "consultation", "procedure", "lab", "imaging", "other"
  status            String   @default("scheduled") // "scheduled", "completed", "cancelled", "missed"
  location          String? // Office name or address
  notes             String?
  reminderSent      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([anonId])
  @@index([appointmentDate])
  @@index([status])
}

model Provider {
  id        String   @id @default(cuid())
  userId    String?
  anonId    String?
  name      String
  specialty String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ratings ProviderRating[]

  @@index([userId])
  @@index([anonId])
}

model ProviderRating {
  id             String   @id @default(cuid())
  userId         String?
  anonId         String?
  providerId     String
  providerName   String
  specialty      String?
  rating         Int // 1-5 stars
  tags           String[] @default([])
  notes          String?
  wouldRecommend Boolean  @default(true)
  lastVisit      DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([anonId])
  @@index([providerId])
}

model PhotoComparison {
  id          String   @id @default(cuid())
  userId      String?
  anonId      String?
  beforePhoto String // URL or path to before photo
  afterPhoto  String // URL or path to after photo
  title       String?
  notes       String?
  daysBetween Int? // Calculated days between photos
  category    String? // "face", "body", "skin", etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([anonId])
  @@index([category])
}

model VoiceMemo {
  id         String   @id @default(cuid())
  userId     String?
  anonId     String?
  audioUrl   String // URL to stored audio file
  transcript String? // AI-generated transcription
  title      String?
  duration   Int? // Duration in seconds
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([anonId])
  @@index([createdAt])
}

model RedFlag {
  id          String   @id @default(cuid())
  userId      String?
  anonId      String?
  type        String // "interaction", "contraindication", "timing", "safety"
  severity    String // "critical", "warning", "info"
  title       String
  description String
  medications String[] @default([])
  dismissed   Boolean  @default(false)
  detectedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([anonId])
  @@index([dismissed])
  @@index([severity])
}

model TrustedCircleMember {
  id           String   @id @default(cuid())
  userId       String // Owner of the vault
  name         String
  email        String
  relationship String?
  permissions  String[] @default([])
  status       String   @default("pending") // "pending", "active", "expired"
  invitedAt    DateTime @default(now())
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([email])
  @@index([status])
}

model TrustedCircleInvite {
  id           String    @id @default(cuid())
  userId       String // Owner sending the invite
  inviteeName  String
  inviteeEmail String
  relationship String?
  permissions  String[]  @default([])
  token        String    @unique @default(cuid())
  status       String    @default("pending") // "pending", "accepted", "expired"
  expiresAt    DateTime?
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([token])
  @@index([status])
  @@index([inviteeEmail])
}
model FamilyMember {
  id           String   @id @default(cuid())
  vaultId      String // Connects to Vault instead of userId directly
  relationship String // "self" | "parent" | "child" | "sibling" | "spouse" | "grandparent" | "aunt" | "uncle" | "cousin" | "other"
  conditionTags String[] @default([]) // Health conditions
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vault Vault @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@index([vaultId])
  @@index([relationship])
}

// P0 PHASE 2: VAULT + BLUEPRINT INTELLIGENCE FOUNDATION
// Single source of truth for all health data

model Vault {
  id        String   @id @default(cuid())
  userId    String   @unique // 1:1 relationship with User
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // All vault data connects here
  vaultItems    VaultItem[]
  familyMembers FamilyMember[]
  blueprintInsights BlueprintInsight[]

  @@index([userId])
}

enum VaultItemType {
  DOCUMENT
  LAB
  NOTE
  TOOL_OUTPUT
}

model VaultItem {
  id        String   @id @default(cuid())
  vaultId   String
  type      VaultItemType
  title     String
  metadata  Json // Structured data based on type
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vault Vault @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  // Specific data types
  labResults LabResult[]

  @@index([vaultId])
  @@index([type])
}

model LabResult {
  id          String   @id @default(cuid())
  vaultItemId String
  testName    String
  flags       String[] @default([]) // "normal", "borderline", "abnormal"
  parsedSummary String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vaultItem VaultItem @relation(fields: [vaultItemId], references: [id], onDelete: Cascade)

  @@index([vaultItemId])
}

enum InsightPriority {
  HIGH
  MEDIUM
  LOW
}

enum InsightSource {
  LAB
  FAMILY
  TOOL
  DOCUMENT
}

model BlueprintInsight {
  id        String   @id @default(cuid())
  vaultId   String
  source    InsightSource
  priority  InsightPriority
  message   String // Plain language only
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vault Vault @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@index([vaultId])
  @@index([source])
  @@index([priority])
}

// PHASE 6F: SYSTEM HEALTH & FEATURE FLAGS
// Centralized feature toggles and system health monitoring

enum FeatureFlagType {
  EMERGENCY_TOGGLE
  SYSTEM_CONTROL
  MASCOT_CONTROL
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique // e.g., "mascot-controls", "audio-modes", "exports", "signups", "read-only"
  name        String   // Human readable name
  description String?  // Description of what this flag controls
  type        FeatureFlagType @default(EMERGENCY_TOGGLE)
  enabled     Boolean  @default(true)
  defaultValue Boolean @default(true) // What to default to if flag is missing
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Audit trail
  flagChanges FeatureFlagChange[]

  @@index([key])
  @@index([type])
  @@index([enabled])
}

model FeatureFlagChange {
  id         String   @id @default(cuid())
  flagId     String
  changedBy  String   // Admin user ID who made the change
  oldValue   Boolean
  newValue   Boolean
  reason     String?  // Reason for the change
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  flag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId])
  @@index([changedBy])
  @@index([createdAt])
}

model SystemHealthCheck {
  id        String   @id @default(cuid())
  service   String   // "api", "auth", "vault", "blueprint", "lab-decoder", "stripe"
  status    String   // "healthy", "degraded", "unhealthy", "unknown"
  message   String?  // Status message
  latency   Int?     // Response time in ms
  checkedAt DateTime @default(now())

  @@index([service])
  @@index([status])
  @@index([checkedAt])
}

// PHASE 6G: CONTENT GOVERNANCE
// Mascot script versioning and content control

enum MascotScriptStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model MascotScript {
  id          String   @id @default(cuid())
  mascotId    String   // e.g., "beau-tox", "peppi", "f-ill", "rn-lisa-grace"
  version     String   // Semantic version like "1.0.0"
  status      MascotScriptStatus @default(DRAFT)
  title       String   // Human readable title
  description String?  // Description of changes
  scriptContent Json    // The actual script data (dialogues, behaviors, etc.)
  audioEnabled Boolean @default(true)
  autoplayEnabled Boolean @default(false)
  createdBy   String   // Admin user ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Audit trail
  scriptChanges MascotScriptChange[]

  @@index([mascotId])
  @@index([status])
  @@index([version])
  @@unique([mascotId, version])
}

model MascotScriptChange {
  id         String   @id @default(cuid())
  scriptId   String
  changedBy  String   // Admin user ID
  changeType String   // "created", "updated", "status_changed", "activated", "archived"
  oldValue   Json?    // Previous state
  newValue   Json?    // New state
  reason     String?  // Reason for change
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  script MascotScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@index([scriptId])
  @@index([changedBy])
  @@index([createdAt])
}

// =============================================================================
// P0 RETENTION LAYER: USER AWARENESS SYSTEM
// Tracks user actions to create emotional stickiness and show progress
// =============================================================================

enum UserEventType {
  LAB_UPLOAD
  LAB_DECODED
  FAMILY_ADDED
  FAMILY_UPDATED
  CHAT_USED
  INSIGHT_VIEWED
  DOCUMENT_UPLOADED
  DOCUMENT_DECODED
  BLUEPRINT_UPDATED
  MASCOT_VISITED
  TOOL_USED
  PROVIDER_ADDED
  APPOINTMENT_ADDED
}

model UserEvent {
  id        String        @id @default(cuid())
  userId    String
  type      UserEventType
  source    String        // e.g., 'decode', 'roots', 'harmony', 'slim-t', 'beau-tox', 'vault'
  metadata  Json?         // Optional additional context
  createdAt DateTime      @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([type])
  @@index([source])
  @@index([createdAt])
}

// Tracks the last time a user visited (for "since your last visit" feature)
model UserVisit {
  id            String   @id @default(cuid())
  userId        String   @unique
  lastVisitAt   DateTime @default(now())
  previousVisitAt DateTime? // Track the visit before current for delta calculation
  totalVisits   Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([lastVisitAt])
}

// =============================================================================
// VAULT PASSCODE: Extra protection layer for sensitive actions
// User-chosen passcode, bcrypt hashed, NEVER stored in plain text
// =============================================================================

model UserSecurity {
  id                  String    @id @default(cuid())
  userId              String    @unique
  vaultPasscodeHash   String?   // bcrypt hash of 6-8 digit passcode
  passcodeSetAt       DateTime? // When passcode was last set
  passcodeAttempts    Int       @default(0) // Failed attempts counter
  passcodeLockedUntil DateTime? // Lockout until this time
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// NPA PHASE 1: IDENTITY FOUNDATION
// ============================================

enum NpaStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum IdentityAuditAction {
  ACCOUNT_CREATED
  NPA_ID_GENERATED
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PROFILE_UPDATED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  ACCOUNT_DELETED
}

model IdentityAuditLog {
  id        String              @id @default(cuid())
  userId    String?
  npaId     String?
  action    IdentityAuditAction
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime            @default(now())
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([npaId])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// NPA PHASE 2: PATIENT-OWNED VAULT STORAGE
// ============================================

// Phase 3: Document Processing Status
enum NpaProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NpaDocumentSource {
  EPIC_MYCHART
  CERNER
  ATHENA
  ALLSCRIPTS
  MEDITECH
  NEXTGEN
  ECW
  PATIENT_UPLOAD
  PROVIDER_UPLOAD
  INSURANCE
  LAB_DIRECT
  IMAGING_CENTER
  PHARMACY
  OTHER
}

enum NpaDocumentCategory {
  LAB_RESULT
  IMAGING_REPORT
  IMAGING_SCAN
  VISIT_SUMMARY
  DISCHARGE_SUMMARY
  MEDICATION_LIST
  ALLERGY_LIST
  IMMUNIZATION_RECORD
  PROCEDURE_NOTE
  OPERATIVE_REPORT
  PATHOLOGY_REPORT
  REFERRAL
  INSURANCE_CARD
  INSURANCE_EOB
  CCDA_CCD
  CARE_PLAN
  CONSENT_FORM
  ADVANCE_DIRECTIVE
  OTHER
}

model NpaVaultDocument {
  id               String              @id @default(cuid())
  npaId            String
  userId           String?
  title            String
  category         NpaDocumentCategory @default(OTHER)
  source           NpaDocumentSource   @default(PATIENT_UPLOAD)
  sourceSystem     String?
  dateOfCare       DateTime?
  dateReceived     DateTime?
  uploadedAt       DateTime            @default(now())
  storagePath      String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  extractedText    String?
  isDeleted        Boolean             @default(false)
  deletedAt        DateTime?
  isHidden         Boolean             @default(false) // Phase 3: User can hide from timeline
  hiddenAt         DateTime?
  
  // Phase 3: Document Intelligence - Processing Status
  processingStatus NpaProcessingStatus @default(PENDING)
  processedAt      DateTime?
  processingError  String?
  
  // Phase 3: Document Intelligence - Classification
  documentType     String?             // visit_summary, lab_report, imaging_report, etc.
  classificationConfidence Float?      // 0.0 - 1.0
  
  // Phase 3: Document Intelligence - Extracted Sections (as-written, NO interpretation)
  sections         Json?               // { medications, allergies, diagnoses, labResults, etc. }
  
  // Phase 3: Provider/Facility Info (extracted, not interpreted)
  providerName     String?
  facilityName     String?
  department       String?
  
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  auditLogs        NpaVaultAuditLog[]
  shareLinks       NpaVaultShareLink[]
  
  // Phase 4: Sharing relations
  sharedIn         NpaShareDocument[]
  providerContribution NpaProviderContribution?

  @@index([npaId])
  @@index([userId])
  @@index([category])
  @@index([source])
  @@index([dateOfCare])
  @@index([uploadedAt])
  @@index([isDeleted])
  @@index([isHidden])
  @@index([processingStatus])
  @@index([documentType])
}

enum NpaVaultAction {
  UPLOADED
  VIEWED
  DOWNLOADED
  METADATA_UPDATED
  DELETED
  RESTORED
  SHARED
  SHARE_REVOKED
}

model NpaVaultAuditLog {
  id         String           @id @default(cuid())
  documentId String
  npaId      String
  action     NpaVaultAction
  actorId    String?
  actorNpaId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime         @default(now())
  document   NpaVaultDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([npaId])
  @@index([action])
  @@index([createdAt])
}

// Legacy single-document share link (kept for backwards compatibility)
model NpaVaultShareLink {
  id          String                    @id @default(cuid())
  documentId  String
  npaId       String
  token       String                    @unique
  canDownload Boolean                   @default(false)
  canUpload   Boolean                   @default(false)
  expiresAt   DateTime
  isRevoked   Boolean                   @default(false)
  revokedAt   DateTime?
  revokedBy   String?
  createdAt   DateTime                  @default(now())
  document    NpaVaultDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  accesses    NpaVaultShareLinkAccess[]

  @@index([documentId])
  @@index([npaId])
  @@index([token])
  @@index([expiresAt])
}

model NpaVaultShareLinkAccess {
  id          String            @id @default(cuid())
  shareLinkId String
  accessedAt  DateTime          @default(now())
  ipAddress   String?
  userAgent   String?
  shareLink   NpaVaultShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@index([shareLinkId])
  @@index([accessedAt])
}

// ============================================
// NPA PHASE 4: CONSENT & PERMISSIONED SHARING
// ============================================

enum SharePermission {
  READ_ONLY           // View documents only
  READ_DOWNLOAD       // View and download
  UPLOAD_ALLOWED      // Provider can contribute documents
}

enum ShareAccessAction {
  LINK_VIEWED         // Share page was opened
  DOCUMENT_VIEWED     // Specific document was viewed
  DOCUMENT_DOWNLOADED // Document was downloaded
  DOCUMENT_UPLOADED   // Provider contributed a document
  ACCESS_DENIED       // Attempted access after revocation/expiry
}

// Share session - groups multiple documents into one shareable link
model NpaShareSession {
  id              String            @id @default(cuid())
  npaId           String            // Owner's NPA ID
  userId          String?           // Owner's user ID
  token           String            @unique // Cryptographically secure share token
  
  // Share configuration
  title           String?           // Optional name for the share (e.g., "Records for Dr. Smith")
  permission      SharePermission   @default(READ_ONLY)
  expiresAt       DateTime
  maxUses         Int?              // Optional: limit number of accesses
  useCount        Int               @default(0)
  
  // Patient info shown to provider (patient controls what's visible)
  showPatientName Boolean           @default(true)
  patientDisplayName String?        // What name to show (can be different from account name)
  
  // Status
  isRevoked       Boolean           @default(false)
  revokedAt       DateTime?
  revokedReason   String?
  
  // Timestamps
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lastAccessedAt  DateTime?
  
  // Relations
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  documents       NpaShareDocument[]
  accessLogs      NpaShareAccessLog[]
  contributions   NpaProviderContribution[]

  @@index([npaId])
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([isRevoked])
}

// Documents included in a share session
model NpaShareDocument {
  id              String            @id @default(cuid())
  shareSessionId  String
  documentId      String
  
  // Optional per-document overrides
  customTitle     String?           // Override document title for this share
  
  createdAt       DateTime          @default(now())
  
  shareSession    NpaShareSession   @relation(fields: [shareSessionId], references: [id], onDelete: Cascade)
  document        NpaVaultDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([shareSessionId, documentId])
  @@index([shareSessionId])
  @@index([documentId])
}

// Every access attempt is logged
model NpaShareAccessLog {
  id              String            @id @default(cuid())
  shareSessionId  String
  documentId      String?           // Null if general session access
  
  action          ShareAccessAction
  
  // Accessor information (no account required)
  accessorName    String?           // Provider name if provided
  accessorOrg     String?           // Organization if provided
  accessorEmail   String?           // Email if provided (optional)
  
  // Request metadata
  ipAddress       String?
  userAgent       String?
  
  // Result
  wasSuccessful   Boolean           @default(true)
  denialReason    String?           // If access was denied
  
  accessedAt      DateTime          @default(now())
  
  shareSession    NpaShareSession   @relation(fields: [shareSessionId], references: [id], onDelete: Cascade)

  @@index([shareSessionId])
  @@index([documentId])
  @@index([action])
  @@index([accessedAt])
  @@index([accessorEmail])
}

// ============================================
// NPA PHASE 6: TRUST, GOVERNANCE & EMERGENCY ACCESS
// ============================================

// Emergency Access Model - "Break-Glass Access"
// Disabled by default, explicitly opt-in by patient
enum EmergencyAccessScope {
  CRITICAL_ONLY     // Allergies, medications, critical conditions only
  MEDICATIONS_FULL  // Full medication list + allergies
  SUMMARY_VIEW      // Critical + recent visit summaries
  FULL_VAULT        // Complete vault access (rarely used)
}

// Patient's emergency access configuration (opt-in settings)
model NpaEmergencyAccessSettings {
  id                  String                @id @default(cuid())
  npaId               String                @unique
  userId              String?
  
  // CORE SETTING: Emergency access is DISABLED by default
  isEnabled           Boolean               @default(false)
  
  // Scope of what's visible during emergency
  allowedScope        EmergencyAccessScope  @default(CRITICAL_ONLY)
  
  // Duration configuration (1-4 hours typical)
  maxDurationMinutes  Int                   @default(60)  // 1 hour default
  
  // Emergency contact information (displayed to emergency responders)
  emergencyContactName    String?
  emergencyContactPhone   String?
  emergencyContactRelation String?
  
  // Critical health info displayed in emergency
  knownAllergies      String?               // Text field, user-entered
  currentMedications  String?               // Text field, user-entered
  criticalConditions  String?               // Text field, user-entered
  
  // Patient acknowledgment of emergency access risks
  disclaimerAcceptedAt DateTime?
  
  // Timestamps
  enabledAt           DateTime?
  disabledAt          DateTime?
  lastUpdatedAt       DateTime              @default(now())
  createdAt           DateTime              @default(now())
  
  // Audit relation
  accessSessions      NpaEmergencyAccessSession[]

  @@index([npaId])
  @@index([userId])
  @@index([isEnabled])
}

// Emergency access session - each "break-glass" event
model NpaEmergencyAccessSession {
  id                  String                @id @default(cuid())
  settingsId          String
  npaId               String
  
  // Session token for access
  token               String                @unique
  
  // Access window
  startedAt           DateTime              @default(now())
  expiresAt           DateTime
  endedAt             DateTime?             // Null if still active
  
  // Access scope granted
  grantedScope        EmergencyAccessScope
  
  // Accessor information
  accessorName        String?               // Name of person accessing
  accessorRole        String?               // "Paramedic", "ER Nurse", "First Responder"
  accessorOrg         String?               // "City Fire Dept", "General Hospital ER"
  reasonEntered       String?               // Required reason for access
  
  // Request metadata
  ipAddress           String?
  userAgent           String?
  
  // Status
  wasRevoked          Boolean               @default(false)
  revokedAt           DateTime?
  revokedBy           String?               // NPA ID of who revoked
  revokedReason       String?
  
  // Timestamps
  createdAt           DateTime              @default(now())
  
  // Relations
  settings            NpaEmergencyAccessSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  accessLogs          NpaEmergencyAccessLog[]

  @@index([settingsId])
  @@index([npaId])
  @@index([token])
  @@index([expiresAt])
  @@index([startedAt])
}

// Detailed log of every action during emergency access
model NpaEmergencyAccessLog {
  id                  String                @id @default(cuid())
  sessionId           String
  npaId               String
  
  // What was accessed
  action              String                // "session_started", "document_viewed", "summary_accessed", etc.
  resourceType        String?               // "document", "medication_list", "allergy_list"
  resourceId          String?               // ID of specific resource if applicable
  
  // Request metadata
  ipAddress           String?
  userAgent           String?
  
  // Timestamp
  accessedAt          DateTime              @default(now())
  
  // Relations
  session             NpaEmergencyAccessSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([npaId])
  @@index([action])
  @@index([accessedAt])
}

// Data export request tracking (for one-click export)
model NpaDataExport {
  id                  String                @id @default(cuid())
  npaId               String
  userId              String?
  
  // Export configuration
  exportType          String                // "full", "documents_only", "audit_only", "metadata_only"
  format              String                // "zip", "json"
  
  // Status
  status              String                @default("pending") // "pending", "processing", "completed", "failed"
  
  // Result
  downloadUrl         String?               // Signed URL for download
  downloadExpiresAt   DateTime?
  fileSizeBytes       Int?
  
  // Processing info
  startedAt           DateTime?
  completedAt         DateTime?
  errorMessage        String?
  
  // Timestamps
  requestedAt         DateTime              @default(now())
  downloadedAt        DateTime?
  
  @@index([npaId])
  @@index([userId])
  @@index([status])
  @@index([requestedAt])
}

// MFA enrollment for security hardening
model NpaMfaEnrollment {
  id                  String                @id @default(cuid())
  userId              String                @unique
  npaId               String?
  
  // MFA method
  method              String                @default("totp") // "totp", "sms", "email"
  
  // TOTP-specific
  totpSecret          String?               // Encrypted TOTP secret
  totpVerifiedAt      DateTime?
  
  // Backup codes (hashed)
  backupCodes         String[]              @default([])
  backupCodesGeneratedAt DateTime?
  
  // Status
  isEnabled           Boolean               @default(false)
  
  // Timestamps
  enrolledAt          DateTime?
  lastUsedAt          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([userId])
  @@index([npaId])
  @@index([isEnabled])
}

// Active sessions tracking for device/session management
model NpaUserSession {
  id                  String                @id @default(cuid())
  userId              String
  npaId               String?
  
  // Session identification
  sessionToken        String                @unique
  
  // Device info
  deviceType          String?               // "desktop", "mobile", "tablet"
  deviceName          String?               // "Chrome on MacOS", "Safari on iPhone"
  browser             String?
  os                  String?
  
  // Location
  ipAddress           String?
  location            String?               // Approximate location from IP
  
  // Status
  isActive            Boolean               @default(true)
  
  // Security flags
  isAnomaly           Boolean               @default(false) // Flagged for unusual activity
  anomalyReason       String?
  
  // Timestamps
  createdAt           DateTime              @default(now())
  lastActiveAt        DateTime              @default(now())
  expiresAt           DateTime
  revokedAt           DateTime?
  
  @@index([userId])
  @@index([npaId])
  @@index([sessionToken])
  @@index([isActive])
  @@index([lastActiveAt])
}

// ============================================
// NPA PHASE 5: PROVIDER CONTRIBUTION SYSTEM
// ============================================

// Provider role types
enum ProviderRole {
  MD          // Medical Doctor
  DO          // Doctor of Osteopathic Medicine
  NP          // Nurse Practitioner
  PA          // Physician Assistant
  RN          // Registered Nurse
  LPN         // Licensed Practical Nurse
  PHARMD      // Doctor of Pharmacy
  PT          // Physical Therapist
  OT          // Occupational Therapist
  LCSW        // Licensed Clinical Social Worker
  PHD         // Psychologist (PhD)
  PSYD        // Psychologist (PsyD)
  DMD         // Doctor of Dental Medicine
  DDS         // Doctor of Dental Surgery
  DC          // Doctor of Chiropractic
  OD          // Doctor of Optometry
  DPM         // Doctor of Podiatric Medicine
  OTHER       // Other healthcare provider
}

// Provider-contributed documents (when upload_allowed is enabled)
model NpaProviderContribution {
  id              String            @id @default(cuid())
  shareSessionId  String
  npaId           String            // Patient's NPA ID
  documentId      String            @unique // The new document created (one contribution per document)
  
  // Provider information (REQUIRED for Phase 5)
  providerName    String            // Full name of provider
  providerRole    ProviderRole      @default(OTHER) // MD, DO, NP, PA, RN, etc.
  providerOrg     String?           // Organization / clinic name
  providerEmail   String?           // Optional contact email
  providerNPI     String?           // National Provider Identifier (optional)
  specialty       String?           // e.g., Cardiology, Family Medicine
  
  // Encounter information
  dateOfCare      DateTime?         // Date of the clinical encounter
  
  // Contribution metadata
  contributionType String           // visit_summary, referral, care_note, etc.
  notes           String?           // Optional notes from provider
  
  // Request metadata
  ipAddress       String?
  userAgent       String?
  
  // Timestamps
  createdAt       DateTime          @default(now())
  
  // Relations
  shareSession    NpaShareSession   @relation(fields: [shareSessionId], references: [id], onDelete: Cascade)
  document        NpaVaultDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([shareSessionId])
  @@index([npaId])
  @@index([providerEmail])
  @@index([providerRole])
  @@index([specialty])
  @@index([createdAt])
}
